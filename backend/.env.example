DATABASE_URL=mysql://usuario:contrasena@host:puerto/basededatos
# Máximo de conexiones por proceso (default 2 si falta; entre 1 y 10). Cómo elegirlo: el servidor de la base
# limita las conexiones por usuario (max_user_connections) y en total (max_connections); las conexiones de
# TODOS los backends conectados se suman. Con N integrantes con su backend contra la misma base, usá como
# máximo floor(max_user_connections / N) (si max_user_connections es 0, el límite es max_connections). Cada
# transacción ocupa una conexión hasta terminar, y las lecturas en paralelo de una pantalla hacen cola cuando
# el límite es bajo: con 2 conexiones y ~400 ms por consulta, abrir el detalle de una reserva tarda ~13 s.
# `node scripts/verificar-previo-ecommerce.js` (solo lectura) lee esos límites y recomienda un valor.
DATABASE_CONNECTION_LIMIT=2
# Milisegundos que una conexión del pool puede estar inactiva antes de cerrarse (default 30000). Tiene que ser
# menor que el wait_timeout del servidor (el verificador lo lee y recomienda el valor): si el servidor corta
# una conexión inactiva primero, el driver registra un ECONNABORTED.
DATABASE_IDLE_TIMEOUT_MS=30000

# Tareas automáticas de fondo (barrido de stock mínimo y de transferencias pendientes). "off" las desactiva;
# cualquier otro valor (o vacío) las deja activas. Contra la base COMPARTIDA, solo UN backend del equipo tiene
# que tener las tareas activas: los demás arrancan con TAREAS_AUTOMATICAS=off, si no compiten por las conexiones.
TAREAS_AUTOMATICAS=

# Secreto con el que se firman las sesiones (tokens de login). En producción es OBLIGATORIO y tiene que medir
# al menos 32 caracteres: el backend no arranca sin él. En desarrollo, si falta, se deriva de DATABASE_URL y se
# avisa una sola vez por consola. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo cierra todas las sesiones abiertas.
AUTH_SECRET=

# Servidor SMTP para enviar confirmaciones de reserva a cualquier dominio.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=contrasena_smtp
SMTP_FROM="Holiday Inn <reservas@tudominio.com>"
# El alta (web y mostrador) espera el email como máximo 1,5 s; si el servidor SMTP tarda más, el envío sigue en segundo plano.
# La pasarela simulada no tiene demora artificial: el tiempo del alta es de consultas y email, no de la pasarela.

# URL pública del sitio web (e-commerce), sin barra final. Opcional: si está, el email
# de confirmación incluye el link a Mi reserva (<URL>/web/mi-reserva?codigo=...).
# Si no está, el email indica entrar a Mi reserva con el código y el email.
WEB_PUBLIC_URL=

# Límite de intentos por IP en /api/web (protección del canal, HU-106). Está
# activo siempre; poné "off" solo para pruebas de carga locales.
WEB_LIMITE_INTENTOS=

# Cantidad de proxies inversos delante del backend (o lista de IPs/subredes de confianza, separadas
# por comas). Hace que el límite de intentos de /api/web use la IP real del visitante (X-Forwarded-For)
# en vez de la del proxy. Vacío o "false" = no se confía en ningún proxy (uso local). Con un solo
# proxy delante (Clever Cloud): TRUST_PROXY=1. "true" se rechaza al arrancar (permitiría falsificar la IP).
TRUST_PROXY=

# Contraseña compartida por los 6 usuarios de prueba que crea scripts/seed-usuarios-prueba.js (uno por rol,
# ej. gerente.prueba) y el usuario de scripts/seed-estadia-local.js. OBLIGATORIA, mínimo 10 caracteres: los
# scripts se niegan si falta (no hay contraseña por defecto) y nunca la imprimen. Nunca pongas acá la contraseña
# real que usa el equipo: se comparte aparte.
SEED_USUARIOS_PASSWORD=

# Secreto con el que la pasarela de pagos SIMULADA firma sus tokens de tarjeta (garantías). En producción
# es OBLIGATORIO y tiene que medir al menos 32 caracteres (el backend no arranca sin él). En desarrollo, si
# falta, se usa un valor de prueba y se avisa por consola. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo invalida los tokens ya guardados (las garantías de bases de prueba dejan de poder cobrarse).
PASARELA_TOKEN_SECRETO=

# Contraseña del administrador inicial ("admin") que crea scripts/crear-tabla-usuarios.js la primera vez que se
# prepara una base. OBLIGATORIA en ese caso, mínimo 10 caracteres; el script se niega si falta y nunca la imprime.
# (Si la base ya tiene un administrador, no hace falta.) Cambiala desde "Mi perfil" después de entrar.
ADMIN_PASSWORD_INICIAL=
