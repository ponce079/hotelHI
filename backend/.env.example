DATABASE_URL=mysql://usuario:contrasena@host:puerto/basededatos
# Máximo de conexiones por proceso. Considerar la suma de servidores del equipo.
DATABASE_CONNECTION_LIMIT=2

# Servidor SMTP para enviar confirmaciones de reserva a cualquier dominio.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=contrasena_smtp
SMTP_FROM="Holiday Inn <reservas@tudominio.com>"

# URL pública del sitio web (e-commerce), sin barra final. Opcional: si está, el email
# de confirmación incluye el link a Mi reserva (<URL>/web/mi-reserva?codigo=...).
# Si no está, el email indica entrar a Mi reserva con el código y el email.
WEB_PUBLIC_URL=

# Contraseña compartida por los 6 usuarios de prueba que crea
# scripts/seed-usuarios-prueba.js (uno por rol, ej. gerente.prueba). Si no
# se define, el script usa una contraseña de desarrollo por defecto. Nunca
# pongas acá la contraseña real que usa el equipo — se comparte aparte.
SEED_USUARIOS_PASSWORD=
