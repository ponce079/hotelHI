generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Articulo {
  id                    Int                      @id @default(autoincrement())
  codigo                String?                  @unique
  nombre                String                   @unique(map: "articulos_descripcion_key")
  unidadMedida          String
  categoria             String
  activo                Boolean                  @default(true)
  articuloDepositos     ArticuloDeposito[]
  detalleMovimientos    MovimientoStockDetalle[]
  detalleOC             OrdenCompraDetalle[]
  detalleRequerimientos RequerimientoDetalle[]
  detallePresupuestos   PresupuestoDetalle[]

  @@map("articulos")
}

model Deposito {
  id                 Int                       @id @default(autoincrement())
  nombre             String                    @unique
  ubicacion          String?
  responsable        String?
  activo             Boolean                   @default(true)
  articulos          ArticuloDeposito[]
  movimientos        MovimientoStock[]
  movimientosDestino MovimientoStock[]         @relation("MovimientoDestino")
  requerimientos     RequerimientoReposicion[]
  ordenesCompra      OrdenCompra[]

  @@map("depositos")
}

model ArticuloDeposito {
  id         Int                    @id @default(autoincrement())
  articuloId Int
  depositoId Int
  activo     Boolean                @default(true)
  articulo   Articulo               @relation(fields: [articuloId], references: [id])
  deposito   Deposito               @relation(fields: [depositoId], references: [id])
  stock      ArticuloDepositoStock?

  @@unique([articuloId, depositoId])
  @@index([depositoId], map: "articulos_depositos_depositoId_fkey")
  @@map("articulos_depositos")
}

model ArticuloDepositoStock {
  id                 Int              @id @default(autoincrement())
  articuloDepositoId Int              @unique
  stockActual        Decimal          @default(0.00) @db.Decimal(12, 2)
  stockMinimo        Decimal          @default(0.00) @db.Decimal(12, 2)
  stockMaximo        Decimal?         @db.Decimal(12, 2)
  actualizadoEn      DateTime         @updatedAt
  articuloDeposito   ArticuloDeposito @relation(fields: [articuloDepositoId], references: [id])

  @@map("articulos_depositos_stock")
}

model TipoMovimientoStock {
  id          Int               @id @default(autoincrement())
  descripcion String            @unique
  tipo        String
  // "NORMAL": elegible a mano en Entrada/Salida. "TRANSFERENCIA": reservado
  // para el flujo de Transferencia/Recepción, el sistema lo asigna solo.
  contexto    String            @default("NORMAL")
  activo      Boolean           @default(true)
  movimientos MovimientoStock[]

  @@map("tipo_movimientos_stock")
}

model MovimientoStock {
  id                      Int                      @id @default(autoincrement())
  fecha                   DateTime                 @default(now())
  detalle                 String?
  depositoId              Int
  depositoDestinoId       Int?
  tipoMovStockId          Int
  movimientoRelacionadoId Int?
  ordenCompraId           Int?
  estado                  String                   @default("Confirmado")
  activo                  Boolean                  @default(true)
  usuario                 String?
  deposito                Deposito                 @relation(fields: [depositoId], references: [id])
  depositoDestino         Deposito?                @relation("MovimientoDestino", fields: [depositoDestinoId], references: [id])
  tipoMovStock            TipoMovimientoStock      @relation(fields: [tipoMovStockId], references: [id])
  ordenCompra             OrdenCompra?             @relation(fields: [ordenCompraId], references: [id])
  detalleMovimientos      MovimientoStockDetalle[]

  @@index([depositoId], map: "movimientos_stock_depositoId_fkey")
  @@index([depositoDestinoId], map: "movimientos_stock_depositoDestinoId_fkey")
  @@index([tipoMovStockId], map: "movimientos_stock_tipoMovStockId_fkey")
  @@index([ordenCompraId], map: "movimientos_stock_ordenCompraId_fkey")
  @@map("movimientos_stock")
}

model MovimientoStockDetalle {
  id               Int             @id @default(autoincrement())
  movStockId       Int
  articuloId       Int
  cantidad         Decimal         @db.Decimal(12, 2)
  cantidadRecibida Decimal?        @db.Decimal(12, 2)
  articulo         Articulo        @relation(fields: [articuloId], references: [id])
  movimientoStock  MovimientoStock @relation(fields: [movStockId], references: [id])

  @@index([articuloId], map: "movimientos_stock_detalle_articuloId_fkey")
  @@index([movStockId], map: "movimientos_stock_detalle_movStockId_fkey")
  @@map("movimientos_stock_detalle")
}

// ────────────────────────────────────────────────────────────
// Sprint 2 — Compras y Gastos
// ────────────────────────────────────────────────────────────

model Proveedor {
  id                 Int                    @id @default(autoincrement())
  razonSocial        String
  cuit               String                 @unique
  contacto           String?
  email              String?
  telefono           String?
  direccion          String?
  // Lista fija validada en código (mismo criterio que categoria/unidadMedida de Articulo):
  // "Contado" | "15 días cta. cte." | "30 días cta. cte." | "60 días cta. cte."
  condicionComercial String?
  activo             Boolean                @default(true)
  rubros             ProveedorRubro[]
  ordenesCompra      OrdenCompra[]
  presupuestos       Presupuesto[]
  comprobantes       ComprobanteProveedor[]
  ordenesPago        OrdenPago[]

  @@map("proveedores")
}

model ProveedorRubro {
  id          Int       @id @default(autoincrement())
  proveedorId Int
  // Lista fija validada en código: Alimentos, Bebidas, Blancos y textiles,
  // Limpieza, Amenities, Mantenimiento, Bazar y menaje.
  rubro       String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([proveedorId, rubro])
  @@map("proveedores_rubros")
}

model RequerimientoReposicion {
  id            Int                    @id @default(autoincrement())
  depositoId    Int
  fecha         DateTime               @default(now())
  // Pendiente | En cotización | Aprobado
  estado        String                 @default("Pendiente")
  // "MANUAL" | "ALERTA" (generado desde la alerta de stock mínimo, HU-8)
  origen        String                 @default("MANUAL")
  requiereFlete Boolean                @default(false)
  solicitante   String?
  deposito      Deposito               @relation(fields: [depositoId], references: [id])
  detalle       RequerimientoDetalle[]
  presupuestos  Presupuesto[]

  @@index([depositoId], map: "requerimientos_reposicion_depositoId_fkey")
  @@map("requerimientos_reposicion")
}

model RequerimientoDetalle {
  id                 Int                     @id @default(autoincrement())
  requerimientoId    Int
  articuloId         Int
  cantidadSolicitada Decimal                 @db.Decimal(12, 2)
  requerimiento      RequerimientoReposicion @relation(fields: [requerimientoId], references: [id])
  articulo           Articulo                @relation(fields: [articuloId], references: [id])

  @@unique([requerimientoId, articuloId])
  @@index([articuloId], map: "requerimientos_reposicion_detalle_articuloId_fkey")
  @@map("requerimientos_reposicion_detalle")
}

model Presupuesto {
  id              Int                     @id @default(autoincrement())
  requerimientoId Int
  proveedorId     Int
  // Solicitado | Pendiente de aprobación | Rechazado | Adjudicado
  estado          String                  @default("Solicitado")
  plazoEntrega    String?
  costoFlete      Decimal?                @db.Decimal(12, 2)
  fecha           DateTime                @default(now())
  requerimiento   RequerimientoReposicion @relation(fields: [requerimientoId], references: [id])
  proveedor       Proveedor               @relation(fields: [proveedorId], references: [id])
  detalle         PresupuestoDetalle[]
  ordenCompra     OrdenCompra?

  @@unique([requerimientoId, proveedorId])
  @@index([proveedorId], map: "presupuestos_proveedorId_fkey")
  @@map("presupuestos")
}

model PresupuestoDetalle {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  articuloId     Int
  precioUnitario Decimal     @db.Decimal(12, 2)
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id])
  articulo       Articulo    @relation(fields: [articuloId], references: [id])

  @@unique([presupuestoId, articuloId])
  @@index([articuloId], map: "presupuestos_detalle_articuloId_fkey")
  @@map("presupuestos_detalle")
}

model OrdenCompra {
  id              Int                    @id @default(autoincrement())
  numero          String                 @unique
  proveedorId     Int
  presupuestoId   Int                    @unique
  depositoId      Int
  // Pendiente | Aprobada | Enviada | Recibida | Recibida con diferencia | Cerrada | Anulada
  estado          String                 @default("Pendiente")
  montoTotal      Decimal                @default(0.00) @db.Decimal(12, 2)
  flete           Decimal?               @db.Decimal(12, 2)
  motivoAnulacion String?
  fecha           DateTime               @default(now())
  proveedor       Proveedor              @relation(fields: [proveedorId], references: [id])
  presupuesto     Presupuesto            @relation(fields: [presupuestoId], references: [id])
  deposito        Deposito               @relation(fields: [depositoId], references: [id])
  detalle         OrdenCompraDetalle[]
  log             OrdenCompraLog[]
  movimientos     MovimientoStock[]
  comprobantes    ComprobanteProveedor[]

  @@index([proveedorId], map: "ordenes_compra_proveedorId_fkey")
  @@index([depositoId], map: "ordenes_compra_depositoId_fkey")
  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
  id               Int         @id @default(autoincrement())
  ordenCompraId    Int
  articuloId       Int
  cantidad         Decimal     @db.Decimal(12, 2)
  precioUnitario   Decimal     @db.Decimal(12, 2)
  cantidadRecibida Decimal?    @db.Decimal(12, 2)
  articulo         Articulo    @relation(fields: [articuloId], references: [id])
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@unique([ordenCompraId, articuloId])
  @@index([articuloId], map: "orden_compra_detalle_articuloId_fkey")
  @@map("orden_compra_detalle")
}

model OrdenCompraLog {
  id            Int         @id @default(autoincrement())
  ordenCompraId Int
  usuario       String
  accion        String
  fecha         DateTime    @default(now())
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@index([ordenCompraId], map: "ordenes_compra_log_ordenCompraId_fkey")
  @@map("ordenes_compra_log")
}

model ComprobanteProveedor {
  id                       Int                    @id @default(autoincrement())
  proveedorId              Int
  // Factura | Nota de Débito | Nota de Crédito
  tipo                     String
  numero                   String
  fecha                    DateTime               @default(now())
  importeNeto              Decimal                @db.Decimal(12, 2)
  alicuotaIva              Decimal                @db.Decimal(5, 2)
  importeIva               Decimal                @db.Decimal(12, 2)
  importeTotal             Decimal                @db.Decimal(12, 2)
  ordenCompraId            Int?
  comprobanteRelacionadoId Int?
  anulado                  Boolean                @default(false)
  motivoAnulacion          String?
  proveedor                Proveedor              @relation(fields: [proveedorId], references: [id])
  ordenCompra              OrdenCompra?           @relation(fields: [ordenCompraId], references: [id])
  comprobanteRelacionado   ComprobanteProveedor?  @relation("AjustesComprobante", fields: [comprobanteRelacionadoId], references: [id])
  ajustes                  ComprobanteProveedor[] @relation("AjustesComprobante")
  pagosAplicados           OrdenPagoDetalle[]

  @@unique([proveedorId, tipo, numero])
  @@index([ordenCompraId], map: "comprobantes_proveedor_ordenCompraId_fkey")
  @@index([comprobanteRelacionadoId], map: "comprobantes_proveedor_comprobanteRelacionadoId_fkey")
  @@map("comprobantes_proveedor")
}

model OrdenPago {
  id              Int                @id @default(autoincrement())
  numero          String             @unique
  proveedorId     Int
  fecha           DateTime           @default(now())
  // Pagado | Rechazada
  estado          String             @default("Pagado")
  anulado         Boolean            @default(false)
  motivoAnulacion String?
  proveedor       Proveedor          @relation(fields: [proveedorId], references: [id])
  detalle         OrdenPagoDetalle[]
  medios          OrdenPagoMedio[]

  @@index([proveedorId], map: "ordenes_pago_proveedorId_fkey")
  @@map("ordenes_pago")
}

model OrdenPagoDetalle {
  id              Int                  @id @default(autoincrement())
  ordenPagoId     Int
  comprobanteId   Int
  importeAplicado Decimal              @db.Decimal(12, 2)
  ordenPago       OrdenPago            @relation(fields: [ordenPagoId], references: [id])
  comprobante     ComprobanteProveedor @relation(fields: [comprobanteId], references: [id])

  @@index([ordenPagoId], map: "ordenes_pago_detalle_ordenPagoId_fkey")
  @@index([comprobanteId], map: "ordenes_pago_detalle_comprobanteId_fkey")
  @@map("ordenes_pago_detalle")
}

model OrdenPagoMedio {
  id           Int       @id @default(autoincrement())
  ordenPagoId  Int
  // Efectivo | Transferencia | Cheque
  medioPago    String
  importe      Decimal   @db.Decimal(12, 2)
  numeroCheque String?
  banco        String?
  fechaCheque  DateTime?
  // Emitido | Cobrado | Rechazado — solo aplica si medioPago = Cheque
  estadoCheque String?
  ordenPago    OrdenPago @relation(fields: [ordenPagoId], references: [id])

  // Sin @@unique(banco, numeroCheque) a propósito: un cheque debe poder
  // reusarse una vez que la orden que lo tenía se anula o se rechaza
  // (HU-79, HU-86), y MySQL no tiene índices únicos parciales/condicionales
  // como Postgres para expresar "único solo entre los vigentes". La
  // unicidad la garantiza el código (pagos.servicio.js, revalidado dentro
  // de la transacción) contra los medios con pagoVigente(ordenPago).
  @@index([banco, numeroCheque], map: "ordenes_pago_medio_banco_numeroCheque_idx")
  @@index([ordenPagoId], map: "ordenes_pago_medio_ordenPagoId_fkey")
  @@map("ordenes_pago_medio")
}
