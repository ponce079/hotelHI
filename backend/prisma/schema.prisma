generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Articulo {
  id                        Int                        @id @default(autoincrement())
  codigo                    String?                    @unique
  nombre                    String                     @unique(map: "articulos_descripcion_key")
  unidadMedida              String
  categoria                 String
  activo                    Boolean                    @default(true)
  // A qué depósito central pertenece este artículo (Sprint 3 — Transferencia
  // a Central). Sin asignar, el artículo no puede pedirse por TRANSFERENCIA:
  // el sistema no tendría a quién dirigirla sin preguntarle al usuario.
  depositoCentralId         Int?
  // "SUGERIDA" | "AUTOMATICA" — controla si la reposición del central
  // disparada por punto de reorden o por una transferencia bloqueada por
  // falta de stock entra directo al tablero de Compras (Pendiente, igual
  // que el origen ALERTA de hoy) o queda en una bandeja de sugerencias que
  // alguien debe confirmar antes.
  modoReposicion            String                     @default("SUGERIDA")
  depositoCentral           Deposito?                  @relation("ArticuloDepositoCentral", fields: [depositoCentralId], references: [id])
  articuloDepositos         ArticuloDeposito[]
  detalleMovimientos        MovimientoStockDetalle[]
  detalleOC                 OrdenCompraDetalle[]
  detalleRequerimientos     RequerimientoDetalle[]
  detallePresupuestos       PresupuestoDetalle[]
  // Sprint 3 — consumo de servicios adicionales (Minibar) que descuenta stock de este artículo.
  consumosServicioAdicional ConsumoServicioAdicional[]

  @@index([depositoCentralId], map: "articulos_depositoCentralId_fkey")
  @@map("articulos")
}

model Deposito {
  id                    Int                       @id @default(autoincrement())
  nombre                String                    @unique
  ubicacion             String?
  responsable           String?
  activo                Boolean                   @default(true)
  // Depósito central (Sprint 3): origen de las transferencias internas.
  // Existen 1 o 2 en todo el sistema, marcados a mano desde el ABM.
  esCentral             Boolean                   @default(false)
  articulos             ArticuloDeposito[]
  articulosCentral      Articulo[]                @relation("ArticuloDepositoCentral")
  movimientos           MovimientoStock[]
  movimientosDestino    MovimientoStock[]         @relation("MovimientoDestino")
  requerimientos        RequerimientoReposicion[]
  requerimientosCentral RequerimientoReposicion[] @relation("RequerimientoDepositoCentral")
  ordenesCompra         OrdenCompra[]

  @@map("depositos")
}

model ArticuloDeposito {
  id         Int                    @id @default(autoincrement())
  articuloId Int
  depositoId Int
  activo     Boolean                @default(true)
  articulo   Articulo               @relation(fields: [articuloId], references: [id])
  deposito   Deposito               @relation(fields: [depositoId], references: [id])
  stock      ArticuloDepositoStock?

  @@unique([articuloId, depositoId])
  @@index([depositoId], map: "articulos_depositos_depositoId_fkey")
  @@map("articulos_depositos")
}

model ArticuloDepositoStock {
  id                 Int              @id @default(autoincrement())
  articuloDepositoId Int              @unique
  stockActual        Decimal          @default(0.00) @db.Decimal(12, 2)
  stockMinimo        Decimal          @default(0.00) @db.Decimal(12, 2)
  stockMaximo        Decimal?         @db.Decimal(12, 2)
  actualizadoEn      DateTime         @updatedAt
  articuloDeposito   ArticuloDeposito @relation(fields: [articuloDepositoId], references: [id])

  @@map("articulos_depositos_stock")
}

model TipoMovimientoStock {
  id          Int               @id @default(autoincrement())
  descripcion String            @unique
  tipo        String
  // "NORMAL": elegible a mano en Entrada/Salida. "TRANSFERENCIA": reservado
  // para el flujo de Transferencia/Recepción, el sistema lo asigna solo.
  contexto    String            @default("NORMAL")
  activo      Boolean           @default(true)
  movimientos MovimientoStock[]

  @@map("tipo_movimientos_stock")
}

model MovimientoStock {
  id                       Int                       @id @default(autoincrement())
  fecha                    DateTime                  @default(now())
  detalle                  String?
  depositoId               Int
  depositoDestinoId        Int?
  tipoMovStockId           Int
  movimientoRelacionadoId  Int?
  ordenCompraId            Int?
  estado                   String                    @default("Confirmado")
  activo                   Boolean                   @default(true)
  usuario                  String?
  // Seguimiento de la resolución de una transferencia "Con diferencia"
  // (HU-14/17) — vive en la fila de la transferencia (depositoDestinoId
  // no nulo), no en su entrada relacionada. No toca cantidadRecibida ni
  // ningún otro dato histórico: es una marca aparte de "alguien ya miró
  // esto", independiente de la recepción en sí.
  // "Reclamado al depósito" | "Se acepta la diferencia" |
  // "Se generó pedido por la diferencia" | "Otro" — ver MOTIVOS_RESOLUCION_DIFERENCIA.
  diferenciaRevisada       Boolean                   @default(false)
  motivoResolucion         String?
  revisadoPor              String?
  fechaRevision            DateTime?
  deposito                 Deposito                  @relation(fields: [depositoId], references: [id])
  depositoDestino          Deposito?                 @relation("MovimientoDestino", fields: [depositoDestinoId], references: [id])
  tipoMovStock             TipoMovimientoStock       @relation(fields: [tipoMovStockId], references: [id])
  ordenCompra              OrdenCompra?              @relation(fields: [ordenCompraId], references: [id])
  detalleMovimientos       MovimientoStockDetalle[]
  requerimiento            RequerimientoReposicion?
  consumoServicioAdicional ConsumoServicioAdicional?

  @@index([depositoId], map: "movimientos_stock_depositoId_fkey")
  @@index([depositoDestinoId], map: "movimientos_stock_depositoDestinoId_fkey")
  @@index([tipoMovStockId], map: "movimientos_stock_tipoMovStockId_fkey")
  @@index([ordenCompraId], map: "movimientos_stock_ordenCompraId_fkey")
  @@map("movimientos_stock")
}

model MovimientoStockDetalle {
  id               Int             @id @default(autoincrement())
  movStockId       Int
  articuloId       Int
  cantidad         Decimal         @db.Decimal(12, 2)
  cantidadRecibida Decimal?        @db.Decimal(12, 2)
  articulo         Articulo        @relation(fields: [articuloId], references: [id])
  movimientoStock  MovimientoStock @relation(fields: [movStockId], references: [id])

  @@index([articuloId], map: "movimientos_stock_detalle_articuloId_fkey")
  @@index([movStockId], map: "movimientos_stock_detalle_movStockId_fkey")
  @@map("movimientos_stock_detalle")
}

// ────────────────────────────────────────────────────────────
// Sprint 2 — Compras y Gastos
// ────────────────────────────────────────────────────────────

model Proveedor {
  id                 Int                    @id @default(autoincrement())
  razonSocial        String
  cuit               String                 @unique
  contacto           String?
  email              String?
  telefono           String?
  direccion          String?
  // Lista fija validada en código (mismo criterio que categoria/unidadMedida de Articulo):
  // "Contado" | "15 días cta. cte." | "30 días cta. cte." | "60 días cta. cte."
  condicionComercial String?
  activo             Boolean                @default(true)
  rubros             ProveedorRubro[]
  ordenesCompra      OrdenCompra[]
  presupuestos       Presupuesto[]
  comprobantes       ComprobanteProveedor[]
  ordenesPago        OrdenPago[]

  @@map("proveedores")
}

model ProveedorRubro {
  id          Int       @id @default(autoincrement())
  proveedorId Int
  // Lista fija validada en código: Alimentos, Bebidas, Blancos y textiles,
  // Limpieza, Amenities, Mantenimiento, Bazar y menaje.
  rubro       String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([proveedorId, rubro])
  @@map("proveedores_rubros")
}

model RequerimientoReposicion {
  id                        Int                       @id @default(autoincrement())
  depositoId                Int
  fecha                     DateTime                  @default(now())
  // Sugerida | Pendiente | En cotización | Aprobado | Pendiente de stock |
  // En tránsito | Recibida | Cerrada | Rechazada (ya no alcanzable — era
  // solo de la excepción de compra directa que se eliminó)
  estado                    String                    @default("Pendiente")
  // "MANUAL" | "ALERTA" (stock mínimo, HU-8) | "TRANSFERENCIA_BLOQUEADA"
  // (reposición del central disparada porque una transferencia no tenía
  // stock para completarse, Sprint 3)
  origen                    String                    @default("MANUAL")
  // Solo lo puede setear crearOSugerirReposicionCentral, al nacer en
  // "Sugerida" (modoReposicion del artículo != AUTOMATICA) — único lugar
  // real. Fuente de verdad para el timeline (¿existe el nodo "Sugerencia
  // confirmada"?): reemplaza parsear texto de RequerimientoLog, que era
  // frágil (dos formatos de mensaje distintos según quién creó el
  // registro). Default false, sin backfill de históricos.
  nacioComoSugerida         Boolean                   @default(false)
  requiereFlete             Boolean                   @default(false)
  solicitante               String?
  // "COMPRA" (a un proveedor externo) | "TRANSFERENCIA" (a un depósito
  // central interno). Sprint 3 — Transferencia a Central.
  tipo                      String                    @default("COMPRA")
  // Prioriza en el picking del central y habilita "compra express" (saltar
  // Presupuesto) cuando tipo = COMPRA.
  urgente                   Boolean                   @default(false)
  // Solo para tipo TRANSFERENCIA: a qué central se le pide. Desnormalizado
  // desde Articulo.depositoCentralId de las líneas del detalle (todas
  // tienen que compartir el mismo central, si no se pide dividir la
  // solicitud).
  depositoCentralId         Int?
  // El traslado físico (MovimientoStock "En tránsito" → recibido) una vez
  // que la transferencia se aprueba y reserva stock del central.
  movimientoStockId         Int?                      @unique
  // Auto-relación: en una TRANSFERENCIA que cae en "Pendiente de stock",
  // apunta al requerimiento tipo COMPRA (reposición del central) generado
  // para destrabarla.
  requerimientoCompraId     Int?
  // Baja lógica — mismo criterio que OrdenCompra.motivoAnulacion: solo se
  // puede anular en "Pendiente" o "Sugerida" (antes de comprometer a un
  // proveedor con una solicitud de presupuesto o de reservar stock del
  // central), nunca se borra el registro.
  anulado                   Boolean                   @default(false)
  motivoAnulacion           String?
  deposito                  Deposito                  @relation(fields: [depositoId], references: [id])
  depositoCentral           Deposito?                 @relation("RequerimientoDepositoCentral", fields: [depositoCentralId], references: [id])
  movimientoStock           MovimientoStock?          @relation(fields: [movimientoStockId], references: [id])
  requerimientoCompra       RequerimientoReposicion?  @relation("ReposicionPorTransferenciaBloqueada", fields: [requerimientoCompraId], references: [id])
  transferenciasQueDestraba RequerimientoReposicion[] @relation("ReposicionPorTransferenciaBloqueada")
  detalle                   RequerimientoDetalle[]
  presupuestos              Presupuesto[]
  log                       RequerimientoLog[]

  @@index([depositoId], map: "requerimientos_reposicion_depositoId_fkey")
  @@index([depositoCentralId], map: "requerimientos_reposicion_depositoCentralId_fkey")
  @@index([requerimientoCompraId], map: "requerimientos_reposicion_requerimientoCompraId_fkey")
  @@map("requerimientos_reposicion")
}

model RequerimientoLog {
  id              Int                     @id @default(autoincrement())
  requerimientoId Int
  usuario         String
  accion          String
  fecha           DateTime                @default(now())
  requerimiento   RequerimientoReposicion @relation(fields: [requerimientoId], references: [id])

  @@index([requerimientoId], map: "requerimientos_reposicion_log_requerimientoId_fkey")
  @@map("requerimientos_reposicion_log")
}

model RequerimientoDetalle {
  id                 Int                     @id @default(autoincrement())
  requerimientoId    Int
  articuloId         Int
  cantidadSolicitada Decimal                 @db.Decimal(12, 2)
  requerimiento      RequerimientoReposicion @relation(fields: [requerimientoId], references: [id])
  articulo           Articulo                @relation(fields: [articuloId], references: [id])

  @@unique([requerimientoId, articuloId])
  @@index([articuloId], map: "requerimientos_reposicion_detalle_articuloId_fkey")
  @@map("requerimientos_reposicion_detalle")
}

model Presupuesto {
  id                     Int                     @id @default(autoincrement())
  requerimientoId        Int
  proveedorId            Int
  // Solicitado | Pendiente de aprobación | Rechazado | Adjudicado
  estado                 String                  @default("Solicitado")
  plazoEntrega           String?
  costoFlete             Decimal?                @db.Decimal(12, 2)
  // Hasta cuándo vale la cotización del proveedor — puramente informativo
  // (no bloquea adjudicar una oferta vencida, ver nota en
  // presupuestos.servicio.js sobre por qué). Opcional: no todos los
  // proveedores dan un plazo de vigencia explícito.
  fechaLimiteVigencia    DateTime?
  fecha                  DateTime                @default(now())
  // Respaldo documental del presupuesto del proveedor (punto 9 del
  // rediseño de Presupuestos) — un solo archivo opcional, reemplazable, no
  // una galería. Guardado como BLOB en la misma base (sin storage externo,
  // mismo patrón simple que ya usa el resto del proyecto): el equipo no
  // tenía confirmado si el proceso de la API corre sobre disco persistente,
  // así que un archivo en disco local podía perderse en cada redeploy.
  // `archivoTamano` en bytes, para mostrarlo sin releer el blob entero.
  archivoAdjunto         Bytes?                  @db.LongBlob
  archivoNombre          String?
  archivoTipo            String?
  archivoTamano          Int?
  // Puntos 4 y 5 de la revisión de Comparación de presupuestos — campos
  // persistidos (mismo criterio que nacioComoSugerida en
  // RequerimientoReposicion): nada de reconstruir esto parseando
  // RequerimientoLog, que ya mostró ser frágil una vez (ver REQ-0046).
  // `fechaAdjudicacion` se setea junto con estado=Adjudicado, nunca antes.
  // `comentarioAdjudicacion` es opcional: por qué se eligió este
  // presupuesto — se pide en el mismo momento de adjudicar (no hay una
  // acción separada de "rechazar" en la UI: el resto queda Rechazado como
  // consecuencia automática de la misma transacción).
  fechaAdjudicacion      DateTime?
  comentarioAdjudicacion String?                 @db.Text
  requerimiento          RequerimientoReposicion @relation(fields: [requerimientoId], references: [id])
  proveedor              Proveedor               @relation(fields: [proveedorId], references: [id])
  detalle                PresupuestoDetalle[]
  ordenCompra            OrdenCompra?

  @@unique([requerimientoId, proveedorId])
  @@index([proveedorId], map: "presupuestos_proveedorId_fkey")
  @@map("presupuestos")
}

model PresupuestoDetalle {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  articuloId     Int
  precioUnitario Decimal     @db.Decimal(12, 2)
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id])
  articulo       Articulo    @relation(fields: [articuloId], references: [id])

  @@unique([presupuestoId, articuloId])
  @@index([articuloId], map: "presupuestos_detalle_articuloId_fkey")
  @@map("presupuestos_detalle")
}

model OrdenCompra {
  id                 Int                    @id @default(autoincrement())
  numero             String                 @unique
  proveedorId        Int
  presupuestoId      Int                    @unique
  depositoId         Int
  // Pendiente | Enviada | Recibida | Recibida con diferencia | Cerrada | Anulada
  estado             String                 @default("Pendiente")
  montoTotal         Decimal                @default(0.00) @db.Decimal(12, 2)
  flete              Decimal?               @db.Decimal(12, 2)
  motivoAnulacion    String?
  fecha              DateTime               @default(now())
  // Cuándo pasó a Recibida/Recibida con diferencia (registrarRecepcion) —
  // persistido en vez de inferirlo de OrdenCompraLog para saber "hace
  // cuánto está recibida sin comprobante" (indicador de la lista de OC).
  // Mismo criterio que nacioComoSugerida/fechaAdjudicacion en otros
  // módulos: nada de parsear texto de log para esto.
  fechaRecibida      DateTime?
  // Seguimiento de la resolución de una OC "Recibida con diferencia" —
  // mismo patrón que MovimientoStock.diferenciaRevisada (Parte A), pero acá
  // vive en la cabecera de la OC, no por línea: la resolución (Nota de
  // Crédito / reposición al proveedor / se acepta) se decide una sola vez
  // por OC aunque la diferencia haya sido en varias líneas. Independiente
  // de matching de 3 vías (comprobantes.servicio.js:calcularMatching): ese
  // se calcula al vuelo contra el importeTotal original de la factura y
  // una Nota de Crédito nunca lo cambia, así que no puede ser la misma
  // bandera — ver diagnóstico de Recepciones Parte B.
  // "Nota de crédito registrada" | "Reposición pedida al proveedor" |
  // "Se acepta la diferencia" — ver MOTIVOS_RESOLUCION_DIFERENCIA_OC.
  diferenciaRevisada Boolean                @default(false)
  motivoResolucion   String?
  revisadoPor        String?
  fechaRevision      DateTime?
  proveedor          Proveedor              @relation(fields: [proveedorId], references: [id])
  presupuesto        Presupuesto            @relation(fields: [presupuestoId], references: [id])
  deposito           Deposito               @relation(fields: [depositoId], references: [id])
  detalle            OrdenCompraDetalle[]
  log                OrdenCompraLog[]
  movimientos        MovimientoStock[]
  comprobantes       ComprobanteProveedor[]

  @@index([proveedorId], map: "ordenes_compra_proveedorId_fkey")
  @@index([depositoId], map: "ordenes_compra_depositoId_fkey")
  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
  id               Int         @id @default(autoincrement())
  ordenCompraId    Int
  articuloId       Int
  cantidad         Decimal     @db.Decimal(12, 2)
  precioUnitario   Decimal     @db.Decimal(12, 2)
  cantidadRecibida Decimal?    @db.Decimal(12, 2)
  articulo         Articulo    @relation(fields: [articuloId], references: [id])
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@unique([ordenCompraId, articuloId])
  @@index([articuloId], map: "orden_compra_detalle_articuloId_fkey")
  @@map("orden_compra_detalle")
}

model OrdenCompraLog {
  id            Int         @id @default(autoincrement())
  ordenCompraId Int
  usuario       String
  accion        String
  fecha         DateTime    @default(now())
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@index([ordenCompraId], map: "ordenes_compra_log_ordenCompraId_fkey")
  @@map("ordenes_compra_log")
}

model ComprobanteProveedor {
  id                       Int                    @id @default(autoincrement())
  proveedorId              Int
  // Factura | Nota de Débito | Nota de Crédito
  tipo                     String
  numero                   String
  fecha                    DateTime               @default(now())
  importeTotal             Decimal                @db.Decimal(12, 2)
  ordenCompraId            Int?
  comprobanteRelacionadoId Int?
  anulado                  Boolean                @default(false)
  motivoAnulacion          String?
  // Motivo de la nota de débito/crédito (HU-73). Null para Factura.
  motivo                   String?
  // Calculada al crear el comprobante a partir de proveedor.condicionComercial
  // (Contado = misma fecha; "N días cta. cte." = fecha + N días) — se
  // persiste en vez de recalcularse en cada lectura porque la condición
  // comercial del proveedor puede cambiar después sin que eso deba mover
  // el vencimiento de facturas ya emitidas. Solo aplica a Factura; null
  // para ND/NC y para comprobantes cuyo proveedor no tiene condición
  // comercial cargada.
  fechaVencimiento         DateTime?
  proveedor                Proveedor              @relation(fields: [proveedorId], references: [id])
  ordenCompra              OrdenCompra?           @relation(fields: [ordenCompraId], references: [id])
  comprobanteRelacionado   ComprobanteProveedor?  @relation("AjustesComprobante", fields: [comprobanteRelacionadoId], references: [id])
  ajustes                  ComprobanteProveedor[] @relation("AjustesComprobante")
  pagosAplicados           OrdenPagoDetalle[]

  @@unique([proveedorId, tipo, numero])
  @@index([ordenCompraId], map: "comprobantes_proveedor_ordenCompraId_fkey")
  @@index([comprobanteRelacionadoId], map: "comprobantes_proveedor_comprobanteRelacionadoId_fkey")
  @@map("comprobantes_proveedor")
}

model OrdenPago {
  id              Int                @id @default(autoincrement())
  numero          String             @unique
  proveedorId     Int
  fecha           DateTime           @default(now())
  // Pagado | Rechazada
  estado          String             @default("Pagado")
  anulado         Boolean            @default(false)
  motivoAnulacion String?
  proveedor       Proveedor          @relation(fields: [proveedorId], references: [id])
  detalle         OrdenPagoDetalle[]
  medios          OrdenPagoMedio[]

  @@index([proveedorId], map: "ordenes_pago_proveedorId_fkey")
  @@map("ordenes_pago")
}

model OrdenPagoDetalle {
  id              Int                  @id @default(autoincrement())
  ordenPagoId     Int
  comprobanteId   Int
  importeAplicado Decimal              @db.Decimal(12, 2)
  ordenPago       OrdenPago            @relation(fields: [ordenPagoId], references: [id])
  comprobante     ComprobanteProveedor @relation(fields: [comprobanteId], references: [id])

  @@index([ordenPagoId], map: "ordenes_pago_detalle_ordenPagoId_fkey")
  @@index([comprobanteId], map: "ordenes_pago_detalle_comprobanteId_fkey")
  @@map("ordenes_pago_detalle")
}

model OrdenPagoMedio {
  id           Int       @id @default(autoincrement())
  ordenPagoId  Int
  // Efectivo | Transferencia | Cheque
  medioPago    String
  importe      Decimal   @db.Decimal(12, 2)
  numeroCheque String?
  banco        String?
  fechaCheque  DateTime?
  // Emitido | Cobrado | Rechazado — solo aplica si medioPago = Cheque
  estadoCheque String?
  // Fecha en que se marcó el cheque como "Cobrado" (HU-86). Null hasta ese momento.
  fechaCobro   DateTime?
  ordenPago    OrdenPago @relation(fields: [ordenPagoId], references: [id])

  // Sin @@unique(banco, numeroCheque) a propósito: un cheque debe poder
  // reusarse una vez que la orden que lo tenía se anula o se rechaza
  // (HU-79, HU-86), y MySQL no tiene índices únicos parciales/condicionales
  // como Postgres para expresar "único solo entre los vigentes". La
  // unicidad la garantiza el código (pagos.servicio.js, revalidado dentro
  // de la transacción) contra los medios con pagoVigente(ordenPago).
  @@index([banco, numeroCheque], map: "ordenes_pago_medio_banco_numeroCheque_idx")
  @@index([ordenPagoId], map: "ordenes_pago_medio_ordenPagoId_fkey")
  @@map("ordenes_pago_medio")
}

// ────────────────────────────────────────────────────────────
// Sprint 3 — Habitaciones, Reservas, Check-in/Check-out,
// Servicios Adicionales y Facturación y Pagos del Huésped
// Ver Modelo_de_Datos_Sprint3_Holiday_Inn.docx para el detalle
// de columnas y relaciones que sustenta este bloque.
// ────────────────────────────────────────────────────────────

// Etapa 1 de tarifas por temporada (HU-89) — catálogo formal de tipos de
// habitación. Sobre esto se van a colgar las tarifas en las próximas
// etapas: tarifaPorNoche SIGUE viviendo en Habitacion (precio por
// habitación individual, no por tipo) — no mover ese campo acá.
model TipoHabitacion {
  id            Int          @id @default(autoincrement())
  // 2-10 chars, MAYÚSCULAS, letras/dígitos/guion — validado en código
  // (tiposHabitacion.servicio.js), guardado ya normalizado a mayúsculas.
  codigo        String       @unique
  // Unicidad case-insensitive + trim: se valida en código (no alcanza con
  // el @unique de acá), ver tiposHabitacion.servicio.js.
  nombre        String       @unique
  descripcion   String?      @db.Text
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  habitaciones  Habitacion[]

  @@map("tipos_habitacion")
}

model Habitacion {
  id             Int     @id @default(autoincrement())
  numero         String  @unique
  // Sin usar por código nuevo desde HU-89 — el tipo real vive en
  // tipoHabitacionId. Se deja la columna (nullable) hasta el cierre de
  // Etapa 1 (pasar tipoHabitacionId a NOT NULL + borrar esta columna),
  // que se pide aparte cuando todo el equipo corrió la migración.
  tipo             String?
  tipoHabitacionId Int?
  capacidad      Int
  piso           Int
  // Texto libre o JSON con el detalle de equipamiento.
  equipamiento   String? @db.Text
  // libre | ocupada | mantenimiento | bloqueada | en limpieza
  estado         String  @default("libre")
  // Obligatorio solo cuando estado = "bloqueada" (ver cambiarEstadoHabitacion
  // en habitaciones.servicio.js) — no aplica a los demás estados, por eso
  // nullable, mismo criterio que OrdenCompra.motivoAnulacion.
  motivoBloqueo  String? @db.Text
  // Estado justo antes de entrar en "mantenimiento" (ver crearOrdenMantenimiento
  // en habitaciones.servicio.js) — permite devolverla a ese estado (no siempre
  // "libre") cuando la orden se marca "Resuelta", en vez de liberar por error
  // una habitación que seguía ocupada. Se limpia (vuelve a null) al resolver.
  estadoAnterior String?
  // Precio por noche propio de la habitación (no una tarifa fija por tipo).
  tarifaPorNoche Decimal @db.Decimal(12, 2)
  activo         Boolean @default(true)

  tipoHabitacion            TipoHabitacion?             @relation(fields: [tipoHabitacionId], references: [id])
  ordenesMantenimiento      OrdenMantenimiento[]
  reservaHabitaciones       ReservaHabitacion[]
  consumosServicioAdicional ConsumoServicioAdicional[]
  notificaciones            Notificacion[]

  @@index([tipoHabitacionId], map: "habitaciones_tipoHabitacionId_fkey")
  @@map("habitaciones")
}

model OrdenMantenimiento {
  id             Int            @id @default(autoincrement())
  habitacionId   Int
  // Correctivo | Preventivo
  tipoTarea      String
  responsable    String
  fecha          DateTime       @default(now())
  // Prioridad real (ya no dispara ningún aviso — ver Notificacion, retirado
  // de este flujo): solo sirve para destacar/filtrar en el historial.
  urgente        Boolean        @default(false)
  // Pendiente | Resuelta
  estado         String         @default("Pendiente")
  resueltaEn     DateTime?
  // Nombre de quien confirma la resolución (no hay usuario real logueado
  // detrás de ningún rol todavía, igual que el resto del módulo).
  resueltaPor    String?
  habitacion     Habitacion     @relation(fields: [habitacionId], references: [id])
  notificaciones Notificacion[]

  @@index([habitacionId], map: "ordenes_mantenimiento_habitacionId_fkey")
  @@map("ordenes_mantenimiento")
}

model Reserva {
  id                 Int      @id @default(autoincrement())
  huespedId          Int
  fechaDesde         DateTime
  fechaHasta         DateTime
  // Confirmada | En curso (tras check-in) | Cerrada (tras check-out) | Cancelada
  estado             String   @default("Confirmada")
  motivoCancelacion  String?
  codigoConfirmacion String   @unique
  huesped            Huesped  @relation(fields: [huespedId], references: [id])

  reservaHabitaciones        ReservaHabitacion[]
  consumosServicioAdicional  ConsumoServicioAdicional[]
  cargosVerificacionCheckout CargoVerificacionCheckout[]
  pagosEstadia               PagoEstadia[]
  comprobantesEstadia        ComprobanteEstadia[]
  notificaciones             Notificacion[]

  @@index([huespedId], map: "reservas_huespedId_fkey")
  @@map("reservas")
}

model ReservaHabitacion {
  id           Int        @id @default(autoincrement())
  reservaId    Int
  habitacionId Int
  reserva      Reserva    @relation(fields: [reservaId], references: [id])
  habitacion   Habitacion @relation(fields: [habitacionId], references: [id])

  @@unique([reservaId, habitacionId])
  @@index([habitacionId], map: "reservas_habitaciones_habitacionId_fkey")
  @@map("reservas_habitaciones")
}

model Huesped {
  id              Int       @id @default(autoincrement())
  nombre          String
  tipoDocumento   String
  numeroDocumento String
  contacto        String?
  preferencias    String?   @db.Text
  reservas        Reserva[]

  @@map("huespedes")
}

model ConsumoServicioAdicional {
  id                Int              @id @default(autoincrement())
  reservaId         Int
  habitacionId      Int
  // Restaurante | Spa | Lavandería | Minibar
  tipoServicio      String
  // Solo seteado cuando tipoServicio = Minibar, para descontar stock real.
  articuloId        Int?
  cantidad          Decimal?         @db.Decimal(12, 2)
  monto             Decimal          @db.Decimal(12, 2)
  fechaHora         DateTime         @default(now())
  registradoPor     String
  // Solo seteado cuando tipoServicio = Minibar y se generó un movimiento de
  // Salida real (ver serviciosAdicionales.servicio.js). Un artículo puede
  // estar habilitado en más de un depósito a la vez (ej. el mismo vino en
  // Bar, Cocina y Central Secos/Insumos) — sin esta referencia no había
  // forma de saber de qué depósito salió el descuento de un consumo
  // puntual sin parsear el texto libre de MovimientoStock.detalle
  // (encontrado auditando a mano, no con los tests). No se duplica
  // depositoId/cantidad/fecha acá: ya viven en el MovimientoStock
  // referenciado, este campo solo apunta a la fuente de verdad.
  movimientoStockId Int?             @unique
  reserva           Reserva          @relation(fields: [reservaId], references: [id])
  habitacion        Habitacion       @relation(fields: [habitacionId], references: [id])
  articulo          Articulo?        @relation(fields: [articuloId], references: [id])
  movimientoStock   MovimientoStock? @relation(fields: [movimientoStockId], references: [id])

  @@index([reservaId], map: "consumos_servicio_adicional_reservaId_fkey")
  @@index([habitacionId], map: "consumos_servicio_adicional_habitacionId_fkey")
  @@index([articuloId], map: "consumos_servicio_adicional_articuloId_fkey")
  @@map("consumos_servicio_adicional")
}

model PagoEstadia {
  id              Int                @id @default(autoincrement())
  reservaId       Int
  fecha           DateTime           @default(now())
  // Pagado | Parcial
  estado          String             @default("Pagado")
  // Seña (HU-88, al confirmar la reserva) | Garantía (HU-46, depósito en
  // efectivo al check-in) | Pago final (HU-50, el de siempre en el
  // check-out — default, para que las filas ya existentes de antes de este
  // campo no queden con un concepto vacío). Sumado para la pantalla de
  // Movimientos de Pago, que si no no puede distinguir de qué fue cada cobro.
  concepto        String             @default("Pago final")
  anulado         Boolean            @default(false)
  motivoAnulacion String?
  reserva         Reserva            @relation(fields: [reservaId], references: [id])
  medios          PagoEstadiaMedio[]

  @@index([reservaId], map: "pagos_estadia_reservaId_fkey")
  @@map("pagos_estadia")
}

model PagoEstadiaMedio {
  id            Int         @id @default(autoincrement())
  pagoEstadiaId Int
  // Efectivo | Tarjeta crédito | Tarjeta débito | Transferencia | Online
  medioPago     String
  importe       Decimal     @db.Decimal(12, 2)
  referencia    String?     @db.VarChar(191)
  pagoEstadia   PagoEstadia @relation(fields: [pagoEstadiaId], references: [id])

  @@index([pagoEstadiaId], map: "pagos_estadia_medio_pagoEstadiaId_fkey")
  @@map("pagos_estadia_medio")
}

model ComprobanteEstadia {
  id                       Int                  @id @default(autoincrement())
  reservaId                Int
  // Comprobante | Nota de Crédito (mismo patrón que ComprobanteProveedor)
  tipo                     String
  // Correlativo interno, sin validez fiscal
  numero                   String               @unique
  // Fecha de emisión (HU-53). La usa el reporte de caja diaria (HU-54) para
  // ubicar las Notas de Crédito del día.
  fecha                    DateTime             @default(now())
  importeNeto              Decimal              @db.Decimal(12, 2)
  alicuotaIVA              Decimal              @db.Decimal(5, 2)
  importeIVA               Decimal              @db.Decimal(12, 2)
  importeTotal             Decimal              @db.Decimal(12, 2)
  comprobanteRelacionadoId Int?
  // Facturación corporativa (HU-55)
  razonSocialTercero       String?
  cuitTercero              String?
  motivo                   String?
  anulado                  Boolean              @default(false)
  reserva                  Reserva              @relation(fields: [reservaId], references: [id])
  comprobanteRelacionado   ComprobanteEstadia?  @relation("AjustesComprobanteEstadia", fields: [comprobanteRelacionadoId], references: [id])
  ajustes                  ComprobanteEstadia[] @relation("AjustesComprobanteEstadia")

  @@index([reservaId], map: "comprobantes_estadia_reservaId_fkey")
  @@index([comprobanteRelacionadoId], map: "comprobantes_estadia_comprobanteRelacionadoId_fkey")
  @@map("comprobantes_estadia")
}

model Notificacion {
  id                   Int                 @id @default(autoincrement())
  // Mantenimiento | Reserva | Housekeeping
  tipo                 String
  habitacionId         Int?
  ordenMantenimientoId Int?
  reservaId            Int?
  destinatarioArea     String
  // Interno | Email | SMS
  canal                String
  mensaje              String?             @db.Text
  fechaEnvio           DateTime            @default(now())
  habitacion           Habitacion?         @relation(fields: [habitacionId], references: [id])
  ordenMantenimiento   OrdenMantenimiento? @relation(fields: [ordenMantenimientoId], references: [id])
  reserva              Reserva?            @relation(fields: [reservaId], references: [id])

  @@index([habitacionId], map: "notificaciones_habitacionId_fkey")
  @@index([ordenMantenimientoId], map: "notificaciones_ordenMantenimientoId_fkey")
  @@index([reservaId], map: "notificaciones_reservaId_fkey")
  @@map("notificaciones")
}

model CargoVerificacionCheckout {
  id            Int      @id @default(autoincrement())
  reservaId     Int
  // Daño | Faltante | ConsumoNoRegistrado
  tipo          String
  descripcion   String   @db.Text
  monto         Decimal  @db.Decimal(12, 2)
  registradoPor String
  fechaHora     DateTime @default(now())
  reserva       Reserva  @relation(fields: [reservaId], references: [id])

  @@index([reservaId], map: "cargos_verificacion_checkout_reservaId_fkey")
  @@map("cargos_verificacion_checkout")
}
