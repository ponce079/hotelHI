// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Articulo {
  id           Int     @id @default(autoincrement())
  codigo       String  @unique
  descripcion  String
  unidadMedida String
  categoria    String
  activo       Boolean @default(true)

  articuloDepositos  ArticuloDeposito[]
  detalleMovimientos MovimientoStockDetalle[]
  detalleOC          OrdenCompraDetalle[]

  @@map("articulos")
}

model Deposito {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  ubicacion   String?
  responsable String?
  activo      Boolean @default(true)

  articulos   ArticuloDeposito[]
  movimientos MovimientoStock[]

  @@map("depositos")
}

// Relación / habilitación: qué artículos están habilitados en qué depósito
model ArticuloDeposito {
  id         Int     @id @default(autoincrement())
  articuloId Int
  depositoId Int
  activo     Boolean @default(true)

  articulo Articulo               @relation(fields: [articuloId], references: [id])
  deposito Deposito               @relation(fields: [depositoId], references: [id])
  stock    ArticuloDepositoStock?

  @@unique([articuloId, depositoId])
  @@map("articulos_depositos")
}

// Stock real (separado de la relación, se actualiza con cada movimiento)
model ArticuloDepositoStock {
  id                 Int      @id @default(autoincrement())
  articuloDepositoId Int      @unique
  stockActual        Decimal  @default(0) @db.Decimal(12, 2)
  stockMinimo        Decimal  @default(0) @db.Decimal(12, 2)
  stockMaximo        Decimal? @db.Decimal(12, 2)
  actualizadoEn      DateTime @updatedAt

  articuloDeposito ArticuloDeposito @relation(fields: [articuloDepositoId], references: [id])

  @@map("articulos_depositos_stock")
}

// Catálogo de tipos de movimiento (Entrada / Salida)
model TipoMovimientoStock {
  id          Int     @id @default(autoincrement())
  descripcion String  @unique
  tipo        String // "E" = Entrada | "S" = Salida
  activo      Boolean @default(true)

  movimientos MovimientoStock[]

  @@map("tipo_movimientos_stock")
}

// Cabecera del movimiento: UN solo depósito por fila (como en el ejemplo del profesor).
// Una transferencia entre 2 depósitos se registra como 2 filas vinculadas:
// una "Salida" en el depósito origen y una "Entrada" en el depósito destino.
model MovimientoStock {
  id                      Int      @id @default(autoincrement())
  fecha                   DateTime @default(now())
  detalle                 String?
  depositoId              Int
  tipoMovStockId          Int
  movimientoRelacionadoId Int? // apunta a la fila "par" cuando es una transferencia (Salida <-> Entrada)
  activo                  Boolean  @default(true)
  usuario                 String?

  deposito           Deposito                 @relation(fields: [depositoId], references: [id])
  tipoMovStock       TipoMovimientoStock      @relation(fields: [tipoMovStockId], references: [id])
  detalleMovimientos MovimientoStockDetalle[]

  @@map("movimientos_stock")
}

// Detalle: artículo + cantidad por movimiento (estructura similar a ArticuloDeposito)
model MovimientoStockDetalle {
  id         Int     @id @default(autoincrement())
  movStockId Int
  articuloId Int
  cantidad   Decimal @db.Decimal(12, 2)

  movimientoStock MovimientoStock @relation(fields: [movStockId], references: [id])
  articulo        Articulo        @relation(fields: [articuloId], references: [id])

  @@map("movimientos_stock_detalle")
}

model Proveedor {
  id                 Int     @id @default(autoincrement())
  razonSocial        String
  cuit               String  @unique
  contacto           String?
  condicionComercial String?
  rubros             String?
  activo             Boolean @default(true)

  ordenesCompra OrdenCompra[]

  @@map("proveedores")
}

model OrdenCompra {
  id          Int      @id @default(autoincrement())
  numero      String   @unique
  proveedorId Int
  estado      String   @default("Pendiente")
  montoTotal  Decimal  @default(0) @db.Decimal(12, 2)
  fecha       DateTime @default(now())

  proveedor Proveedor            @relation(fields: [proveedorId], references: [id])
  detalle   OrdenCompraDetalle[]

  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
  id             Int     @id @default(autoincrement())
  ordenCompraId  Int
  articuloId     Int
  cantidad       Decimal @db.Decimal(12, 2)
  precioUnitario Decimal @db.Decimal(12, 2)

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  articulo    Articulo    @relation(fields: [articuloId], references: [id])

  @@unique([ordenCompraId, articuloId])
  @@map("orden_compra_detalle")
}
